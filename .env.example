# URL publique du site (sert aux liens des e-mails)
NEXT_PUBLIC_SITE_URL=https://equipia.example.fr

# Projet Supabase (Settings > API) : URL et clé publiable (ou clé anon)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Fonction Edge admin-auth (par défaut : <SUPABASE_URL>/functions/v1/admin-auth)
SUPABASE_ADMIN_FUNCTION_URL=
# Secret partagé avec la fonction Edge (même valeur que le secret « edge_shared_secret » en base)
EQUIPIA_EDGE_SECRET=

# E-mails : resend (production) ou file (développement : fichiers dans .emails/)
EMAIL_TRANSPORT=resend
RESEND_API_KEY=re_xxx
EMAIL_FROM=Équipia <notifications@votre-domaine.fr>
EMAIL_REPLY_TO=contact@gf-web.fr
